{
  "name": "pluginblueprint",
  "version": "2.0.1",
  "description": "Visual editor to create Paper (Minecraft server) plugins",
  "main": "out/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build": "tsc",
    "test": "tsc && mocha",
    "start": "tsc && electron . --debug",
    "pack": "tsc && electron-builder --dir",
    "dist": "tsc && electron-builder",
    "dist:win": "tsc && electron-builder --win",
    "dist:linux": "tsc && electron-builder --linux",
    "dist:all": "tsc && electron-builder -mwl",
    "dist:mac": "tsc && electron-builder --mac"
  },
  "files": [
    "**/*",
    "data",
    "assets",
    "*.js",
    "*.html"
  ],
  "build": {
    "appId": "org.inventivetalent.pluginblueprint",
    "productName": "PluginBlueprint",
    "copyright": "Copyright © 2018-2026 Haylee Schaefer",
    "directories": {
      "output": "dist/out"
    },
    "files": [
      "**/*",
      "data/*",
      "assets/images/*",
      "assets/material-icons/*",
      "node_modules/materialize-css/dist/css/*",
      "!.*/**",
      "!{dev,docs,test,tools}/**",
      "!src/**",
      "!**/*.map",
      "!tsconfig.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "fileAssociations": [
      {
        "ext": "pbp",
        "name": "PluginBlueprint Project",
        "description": "PluginBlueprint Project",
        "icon": "build/icon.ico"
      },
      {
        "ext": "pbg",
        "name": "PluginBlueprint Graph",
        "description": "PluginBlueprint Graph",
        "icon": "build/icon-gray.ico"
      },
      {
        "ext": "pbs",
        "name": "PluginBlueprint Snippet",
        "description": "PluginBlueprint Snippet",
        "icon": "build/icon-gray.ico"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    }
  },
  "author": {
    "name": "Haylee Schaefer",
    "email": "mail@inventivetalent.org",
    "url": "https://inventivetalent.org"
  },
  "homepage": "https://pluginblueprint.net",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/deep-equal": "^1.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jquery": "^4.0.1",
    "@types/materialize-css": "^1.0.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@fortawesome/fontawesome-free": "^5.6.3",
    "@fortawesome/fontawesome-svg-core": "^1.2.12",
    "@fortawesome/free-solid-svg-icons": "^5.6.3",
    "adm-zip": "^0.6.1",
    "deep-equal": "^2.2.3",
    "electron-progressbar": "^2.2.1",
    "electron-prompt": "^1.7.0",
    "fs-extra": "^11.4.1",
    "isomorphic-git": "^1.44.3",
    "jquery": "^3.7.1",
    "key.pics": "^1.0.2",
    "materialize-css": "^1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
